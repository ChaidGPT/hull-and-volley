[sub_resource type="Resource" id="TypeCrewQuarters"]
script = ExtResource("2_room")
room_id = &"type_crew_quarters"
display_name = "CREW QUARTERS"
type_name = "CREW_QUARTERS"
effect_label = "CREW CAPACITY / MORALE"
description = "Housing for off-duty crew. Increases maximum crew capacity and supports crew morale."
color = Color(0.27, 0.2, 0.38, 1)
maximum_health = 80.0

[sub_resource type="Resource" id="TypeSecurity"]
script = ExtResource("2_room")
room_id = &"type_security"
display_name = "SECURITY"
type_name = "SECURITY"
effect_label = "BOARDING DEFENSE / ORDER"
description = "Coordinates armed response to boarders and helps contain unrest among the crew."
color = Color(0.34, 0.13, 0.15, 1)

[sub_resource type="Resource" id="RequiresReactorShipwide"]
script = ExtResource("20_build_requirement")
display_name = "REACTOR REQUIRED"
description = "This system needs a reactor installed somewhere in the ship before the grid can be built."
scope = 1

[sub_resource type="Resource" id="TypeShieldGenerator"]
script = ExtResource("2_room")
room_id = &"type_shield_generator"
display_name = "SHIELD GENERATOR"
type_name = "SHIELDS"
effect_label = "SHIELD CAPACITY / REGEN"
description = "Generates the ship's defensive field. Room size and staffing will determine shield capacity and regeneration."
color = Color(0.08, 0.3, 0.38, 1)
build_requirements = Array[Resource]([SubResource("RequiresReactorShipwide")])

[sub_resource type="Resource" id="TypeReactor"]
script = ExtResource("2_room")
room_id = &"type_reactor"
display_name = "REACTOR"
type_name = "POWER"
effect_label = "POWER GENERATION"
description = "Projects an unlimited local power field. Damage can weaken or collapse its coverage."
color = Color(0.4, 0.3, 0.08, 1)
maximum_health = 120.0

[sub_resource type="Resource" id="RequiresCrewQuartersAdjacent"]
script = ExtResource("20_build_requirement")
display_name = "CREW SUPPORT REQUIRED"
description = "This compartment must touch crew quarters before the grid can be built."
scope = 2

[sub_resource type="Resource" id="TypeMedicalBay"]
script = ExtResource("2_room")
room_id = &"type_medical_bay"
display_name = "MEDICAL BAY"
type_name = "MEDICAL"
effect_label = "HEALING / SURVIVABILITY"
description = "Treats injured crew and reduces deaths from wounds sustained during combat and accidents."
color = Color(0.12, 0.34, 0.27, 1)
maximum_health = 70.0
build_requirements = Array[Resource]([SubResource("RequiresCrewQuartersAdjacent")])

[sub_resource type="Resource" id="TypeMessHall"]
script = ExtResource("2_room")
room_id = &"type_mess_hall"
display_name = "MESS HALL"
type_name = "MESS_HALL"
effect_label = "MORALE / FOOD EFFICIENCY"
description = "Feeds the crew and provides a shared social space, improving morale during long voyages."
color = Color(0.38, 0.27, 0.14, 1)
maximum_health = 60.0

[sub_resource type="Resource" id="TypeWorkshop"]
script = ExtResource("2_room")
room_id = &"type_workshop"
display_name = "ENGINEERING BAY"
type_name = "WORKSHOP"
effect_label = "DAMAGE CONTROL OUTFITTING"
description = "Outfits responders with repair tools and environmental gear. If this bay is damaged, powerless, unstaffed, or inaccessible, new damage-control teams cannot deploy."
color = Color(0.36, 0.2, 0.1, 1)
maximum_health = 90.0

[sub_resource type="Resource" id="TypeSupplyStorage"]
script = ExtResource("2_room")
room_id = &"type_supply_storage"
display_name = "LEGACY SUPPLY COMPARTMENT"
type_name = "SUPPLY_STORAGE"
effect_label = "OPERATIONAL STORAGE"
description = "Compatibility compartment from the retired counted-inventory system. New ships use service-providing grids instead."
grid_label = "SUP"
color = Color(0.18, 0.31, 0.27, 1)
maximum_health = 75.0
storage_role = "SUPPLY"
storage_capacity_per_cell = 60.0

[sub_resource type="Resource" id="TypeCargoHold"]
script = ExtResource("2_room")
room_id = &"type_cargo_hold"
display_name = "CARGO HOLD"
type_name = "CARGO"
effect_label = "STORAGE CAPACITY"
description = "Bulk freight storage for salvage, ore, trade goods, and materials intended for sale or refining. Cargo is not directly issued to crew."
