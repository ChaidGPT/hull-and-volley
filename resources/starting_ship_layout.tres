[resource]
script = ExtResource("1_layout")
design_name = "BAREBONES STARTER"
build_origin = Vector2i(-8, -6)
columns = 16
rows = 16
unlimited_build_space = false
room_types = Array[Resource]([SubResource("Bridge"), SubResource("Unassigned"), SubResource("PortEngine"), SubResource("PortForwardWeapon"), SubResource("TypeCrewQuarters"), SubResource("TypeSecurity"), SubResource("TypeShieldGenerator"), SubResource("TypeReactor"), SubResource("TypeMedicalBay"), SubResource("TypeMessHall"), SubResource("TypeWorkshop"), SubResource("TypeSupplyStorage"), SubResource("TypeCargoHold"), SubResource("TypeHangar"), SubResource("TypeDockingStation")])
weapon_types = Array[Resource]([ExtResource("3_longshot"), ExtResource("4_traverse"), ExtResource("5_laser"), ExtResource("6_plasma"), ExtResource("7_missile")])
module_recipes = Array[Resource]([ExtResource("8_light_module"), ExtResource("9_heavy_module"), ExtResource("10_laser_module"), ExtResource("11_cannon_module"), ExtResource("12_small_laser_module"), ExtResource("13_plasma_module"), ExtResource("14_missile_module"), ExtResource("16_compact_hangar"), ExtResource("17_expanded_hangar"), ExtResource("18_fleet_hangar"), ExtResource("19_heavy_cannon")])
resource_catalog = ExtResource("15_resource_catalog")
rooms = Array[Resource]([SubResource("Bridge"), SubResource("Resource_8cbsc"), SubResource("Resource_cficp"), SubResource("PortEngine")])
